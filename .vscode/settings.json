{
	// Formatea con Prettier apenas guardas el archivo
	"editor.formatOnSave": true,
	"editor.defaultFormatter": "esbenp.prettier-vscode",

	// Además del formateo, corrige automáticamente lo que ESLint pueda arreglar solo
	"editor.codeActionsOnSave": {
		"source.fixAll.eslint": "explicit"
	},

	// Formateador por tipo de archivo (evita que la extensión de Astro compita con Prettier)
	"[javascript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
	"[javascriptreact]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
	"[typescript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
	"[typescriptreact]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
	"[astro]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
	"[json]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
	"[jsonc]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
	"[css]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
	"[markdown]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },

	// Que ESLint también revise archivos .astro (no lo hace por defecto)
	"eslint.validate": ["javascript", "javascriptreact", "typescript", "typescriptreact", "astro"]
}
