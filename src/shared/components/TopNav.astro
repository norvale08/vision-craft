---
import { Sun, Moon, LayoutGrid } from "lucide-astro";
import StepperNav from "./StepperNav";

const { activeItem } = Astro.props;

const isBoards = activeItem === "boards";
---

<header
	class="bg-df-surface/20 dark:bg-df-surface-dark/20 fixed top-0 right-0 left-0 z-50 flex h-14 items-center gap-3 border-b border-gray-200/80 px-3 backdrop-blur-sm md:gap-8 md:px-6 dark:border-gray-800/80"
>
	<!-- Logo -->
	<a
		href="/"
		class="text-df-primary dark:text-df-primary-dark shrink-0 text-base font-bold tracking-tight md:text-lg"
		aria-label="Vision Craft home"
	>
		Vision Craft
	</a>

	<StepperNav activeItem={activeItem} client:load />

	<!-- Right-side actions -->
	<div class="ml-auto flex items-center gap-1">
		<!-- Boards / Tableros -->
		<a
			href="/boards"
			aria-current={isBoards ? "page" : undefined}
			class={`flex items-center gap-2 rounded-full px-3 py-1.5 text-sm font-medium transition-colors ${
				isBoards
					? "bg-df-primary dark:bg-df-primary-dark text-white"
					: "text-df-muted dark:text-df-muted-dark hover:text-df-ink dark:hover:text-df-ink-dark hover:bg-gray-100 dark:hover:bg-gray-800"
			}`}
		>
			<LayoutGrid class="h-4 w-4 shrink-0" aria-hidden="true" />
			<span class="hidden sm:inline">Tableros</span>
		</a>

		<!-- Theme toggle -->
		<button
			id="theme-toggle"
			aria-label="Toggle dark mode"
			class="text-df-muted dark:text-df-muted-dark rounded-full p-2 transition-colors hover:bg-gray-100 dark:hover:bg-gray-800"
		>
			<!-- Sun (visible in dark mode) -->
			<Sun class="hidden h-5 w-5 dark:block" aria-hidden="true" />
			<!-- Moon (visible in light mode) -->
			<Moon class="block h-5 w-5 dark:hidden" aria-hidden="true" />
		</button>
	</div>
</header>

<script>
	const btn = document.getElementById("theme-toggle");
	btn?.addEventListener("click", () => {
		const isDark = document.documentElement.classList.toggle("dark");
		localStorage.setItem("df-theme", isDark ? "dark" : "light");
	});
</script>
