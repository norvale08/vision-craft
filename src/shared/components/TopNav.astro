---
import { Sun, Moon } from "lucide-astro";
---

<header
	class="bg-df-surface/90 dark:bg-df-surface-dark/90 fixed top-0 right-0 left-0 z-50 flex h-14 items-center gap-8 border-b border-gray-200/80 px-6 backdrop-blur-sm dark:border-gray-800/80"
>
	<!-- Logo -->
	<a
		href="/"
		class="text-df-primary dark:text-df-primary-dark shrink-0 text-lg font-bold tracking-tight"
		aria-label="Vision Craft home"
	>
		Vision Craft
	</a>

	<!-- Right-side actions -->
	<div class="ml-auto flex items-center gap-1">
		<!-- Theme toggle -->
		<button
			id="theme-toggle"
			aria-label="Toggle dark mode"
			class="text-df-muted dark:text-df-muted-dark rounded-full p-2 transition-colors hover:bg-gray-100 dark:hover:bg-gray-800"
		>
			<!-- Sun (visible in dark mode) -->
			<Sun class="hidden h-5 w-5 dark:block" aria-hidden="true" />
			<!-- Moon (visible in light mode) -->
			<Moon class="block h-5 w-5 dark:hidden" aria-hidden="true" />
		</button>

		<!-- Avatar -->
		<!-- <button
			aria-label="Open user profile"
			class="ml-1 w-8 h-8 rounded-full overflow-hidden ring-2 ring-df-primary/30 dark:ring-df-primary-dark/30
             bg-gradient-to-br from-df-primary to-df-accent dark:from-df-primary-dark dark:to-df-accent-dark
             flex items-center justify-center text-white text-sm font-bold">
			F
		</button> -->
	</div>
</header>

<script>
	const btn = document.getElementById("theme-toggle");
	btn?.addEventListener("click", () => {
		const isDark = document.documentElement.classList.toggle("dark");
		localStorage.setItem("df-theme", isDark ? "dark" : "light");
	});
</script>
