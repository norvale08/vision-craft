---
interface Props {
	year?: number;
}

const { year = 2024 } = Astro.props;
---

<footer
	class="mt-auto flex items-center justify-between gap-4 border-t border-gray-200 px-8 py-4 dark:border-gray-800"
>
	<small
		class="text-df-muted dark:text-df-muted-dark text-[10px] font-semibold tracking-[0.18em] uppercase not-italic"
	>
		&copy; {year} Vision Craft. All rights reserved.
	</small>
	<slot />
</footer>
