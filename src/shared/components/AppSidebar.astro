---
import { LINKS, type Link } from "../contants/likns";

interface Props {
	activeItem?: string;
}

const { activeItem = "discover" } = Astro.props;

function linkClass(id: string): string {
	const base =
		"flex items-center gap-2.5 px-3 py-2.5 rounded-xl text-sm font-medium transition-colors";
	const active = "bg-df-primary dark:bg-df-primary-dark text-white";
	const inactive =
		"text-df-muted dark:text-df-muted-dark hover:text-df-ink dark:hover:text-df-ink-dark hover:bg-gray-100 dark:hover:bg-gray-800";
	return `${base} ${activeItem === id ? active : inactive}`;
}
---

<aside
	class="fixed left-0 top-14 bottom-0 w-44 flex flex-col py-6 px-3
         bg-df-surface dark:bg-df-surface-dark
         border-r border-gray-200 dark:border-gray-800"
	aria-label="Studio sidebar">
	<!-- Brand identity -->
	<div class="px-3 mb-7">
		<p class="font-bold text-df-ink dark:text-df-ink-dark text-sm leading-none">
			Zona de construcción
		</p>
		<p
			class="text-[9px] font-bold tracking-[0.2em] uppercase text-df-muted dark:text-df-muted-dark mt-1">
			Sueña &amp; enfócate
		</p>
	</div>

	<!-- Primary navigation -->
	<nav aria-label="Studio" class="flex-1">
		<ul class="space-y-0.5" role="list">
			{
				LINKS.map((link: Link) => (
					<li>
						<a
							href={link.href}
							aria-current={activeItem === link.id ? "page" : undefined}
							class={linkClass(link.id)}>
							<link.icon />
							{link.name}
						</a>
					</li>
				))
			}
		</ul>
	</nav>

