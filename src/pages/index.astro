---
import Layout from "../layouts/Layout.astro";
import { Sun, Moon, CirclePlay, Printer, Search, Sparkles } from "lucide-astro";
---

<Layout
	title="Vision Craft — Crea vision boards y expórtalos en alta calidad"
	description="Busca imágenes en Unsplash y Pexels, diseña tu lienzo con drag & drop y exporta a PDF, PNG, JPG o JSON (listo para imprimir)."
>
	<!-- ══ MARKETING NAV ══ -->
	<nav
		class="bg-df-surface/90 dark:bg-df-surface-dark/90 fixed top-0 right-0 left-0 z-50 flex h-14 items-center gap-6 border-b border-gray-200/60 px-8 backdrop-blur-sm dark:border-gray-800/60"
	>
		<a href="/" class="mr-4 shrink-0 text-base font-extrabold">
			<span class="text-df-primary dark:text-df-primary-dark">Vision</span><span
				class="text-df-ink dark:text-df-ink-dark">Craft</span
			>
		</a>
		<div class="hidden flex-1 gap-6 md:flex">
			{
				[
					{ href: "#inicio", label: "Inicio", active: true },
					{ href: "#features", label: "Funciones" },
					{ href: "#gallery", label: "Cómo funciona" },
					{ href: "#cta", label: "Exporta" },
				].map(({ href, label, active }) => (
					<a
						href={href}
						class:list={[
							"text-sm font-medium transition-colors",
							active
								? "text-df-ink dark:text-df-ink-dark border-df-primary dark:border-df-primary-dark border-b-2 pb-0.5"
								: "text-df-muted dark:text-df-muted-dark hover:text-df-ink dark:hover:text-df-ink-dark",
						]}
					>
						{label}
					</a>
				))
			}
		</div>
		<div class="ml-auto flex items-center gap-3">
			<button
				id="landing-theme-toggle"
				aria-label="Toggle dark mode"
				class="text-df-muted dark:text-df-muted-dark rounded-full p-2 transition-colors hover:bg-gray-100 dark:hover:bg-gray-800"
			>
				<Sun class="hidden h-4 w-4 dark:block" aria-hidden="true" />
				<Moon class="block h-4 w-4 dark:hidden" aria-hidden="true" />
			</button>
			<a
				href="/explore"
				class="text-df-muted dark:text-df-muted-dark hover:text-df-ink dark:hover:text-df-ink-dark text-sm font-medium transition-colors"
				>Ir al Studio</a
			>
			<a
				href="/explore"
				class="bg-df-primary dark:bg-df-primary-dark rounded-xl px-4 py-2 text-sm font-bold text-white shadow-sm transition-opacity hover:opacity-90"
			>
				Empezar
			</a>
		</div>
	</nav>

	<div class="pt-14">
		<!-- ══════════════════════════════════════════
         HERO
    ══════════════════════════════════════════ -->
		<section
			id="inicio"
			class="bg-df-bg dark:bg-df-bg-dark relative flex min-h-[82vh] items-center overflow-hidden"
		>
			<!-- Ambient glow -->
			<div
				class="bg-df-primary/10 dark:bg-df-primary-dark/15 pointer-events-none absolute top-1/2 right-0 h-[700px] w-[700px] -translate-y-1/2 rounded-full blur-3xl"
				aria-hidden="true"
			>
			</div>
			<div
				class="bg-df-accent/10 dark:bg-df-accent-dark/10 pointer-events-none absolute top-1/3 right-1/4 h-64 w-64 rounded-full blur-2xl"
				aria-hidden="true"
			>
			</div>

			<div class="relative mx-auto flex w-full max-w-6xl items-center gap-12 px-8">
				<!-- Left: copy -->
				<div class="max-w-xl flex-1">
					<p
						class="text-df-accent dark:text-df-accent-dark border-df-accent/30 dark:border-df-accent-dark/30 mb-5 inline-block rounded-full border px-3 py-1 text-[10px] font-bold tracking-[0.25em] uppercase"
					>
						Explora / Diseña / Exporta
					</p>
					<h1
						class="text-df-ink dark:text-df-ink-dark mb-5 text-5xl leading-[1.05] font-black md:text-6xl"
					>
						Crea tu<br />
						<span class="text-df-primary dark:text-df-primary-dark">vision board</span><br />
						listo para imprimir.
					</h1>
					<p class="text-df-muted dark:text-df-muted-dark mb-8 max-w-md text-base leading-relaxed">
						Encuentra imágenes en Unsplash y Pexels, arrástralas al lienzo y ajústalas a tu estilo.
						Exporta tu vision board en alta calidad: PDF, PNG, JPG o JSON — listo para imprimir.
					</p>
					<div class="flex flex-wrap items-center gap-3">
						<a
							href="/explore"
							class="bg-df-primary dark:bg-df-primary-dark shadow-df-primary/30 dark:shadow-df-primary-dark/20 inline-flex items-center gap-2 rounded-xl px-6 py-3 text-sm font-bold text-white shadow-lg transition-all hover:opacity-90 active:scale-95"
						>
							Crear mi primer board
						</a>
						<a
							href="#gallery"
							class="text-df-ink dark:text-df-ink-dark hover:border-df-primary/40 dark:hover:border-df-primary-dark/40 bg-df-surface dark:bg-df-surface-dark inline-flex items-center gap-2 rounded-xl border-2 border-gray-200 px-5 py-3 text-sm font-semibold transition-all dark:border-gray-700"
						>
							<CirclePlay class="h-4 w-4" aria-hidden="true" />
							Ver cómo funciona
						</a>
					</div>
				</div>

				<!-- Right: visual element -->
				<div class="relative hidden h-[420px] w-[420px] flex-none md:block" aria-hidden="true">
					<!-- Light mode: CSS orb -->
					<div class="relative block h-full w-full dark:hidden">
						<div
							class="from-df-primary/30 to-df-accent/20 absolute inset-0 rounded-full bg-gradient-to-br blur-3xl"
						>
						</div>
						<div
							class="border-df-primary/20 absolute inset-8 flex items-center justify-center overflow-hidden rounded-full border bg-gradient-to-br from-gray-900 to-gray-800 shadow-2xl"
						>
							<div
								class="from-df-primary/40 to-df-accent/30 absolute inset-0 bg-gradient-to-br via-violet-900/60"
							>
							</div>
							<div class="border-df-accent/30 absolute h-52 w-52 rounded-full border"></div>
							<div class="border-df-primary/40 absolute h-36 w-36 rounded-full border"></div>
							<div class="bg-df-accent/60 absolute h-14 w-14 rounded-full blur-xl"></div>
							<div
								class="bg-df-accent/90 shadow-df-accent/50 ring-df-accent/20 relative z-10 h-8 w-8 rounded-full shadow-lg ring-4"
							>
							</div>
						</div>
						<div class="border-df-primary/8 absolute inset-4 rounded-full border"></div>
					</div>

					<!-- Dark mode: atmospheric image -->
					<div class="hidden h-full w-full overflow-hidden rounded-3xl dark:block">
						<img
							src="/twilight_path.png"
							alt=""
							class="h-full w-full object-cover"
							style="filter: sepia(0.4) hue-rotate(15deg) saturate(1.8) brightness(0.85);"
							loading="eager"
						/>
						<div
							class="from-df-bg-dark/80 via-df-bg-dark/20 absolute inset-0 rounded-3xl bg-gradient-to-t to-transparent"
						>
						</div>
						<div
							class="from-df-bg-dark/50 absolute inset-0 rounded-3xl bg-gradient-to-r to-transparent"
						>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- ══════════════════════════════════════════
         FEATURES
    ══════════════════════════════════════════ -->
		<section id="features" class="bg-df-bg dark:bg-df-bg-dark px-8 py-20">
			<div class="mx-auto max-w-5xl">
				<!-- Heading -->
				<div class="mb-12">
					<h2 class="text-df-ink dark:text-df-ink-dark text-3xl font-extrabold">
						Todo el flujo para construir tu vision board
					</h2>
					<p class="text-df-muted dark:text-df-muted-dark mt-2 max-w-md text-sm">
						Explora imágenes, configura el tamaño del lienzo, diseña con drag &amp; drop y exporta
						en formatos listos para compartir o imprimir.
					</p>
				</div>

				<!-- 2×2 Bento cards -->
				<div class="grid grid-cols-2 gap-4">
					<!-- Card 1: Lienzo a tu medida -->
					<div
						class="bg-df-surface dark:bg-df-surface-dark overflow-hidden rounded-2xl border border-gray-200 p-6 dark:border-gray-700/60"
					>
						<h3 class="text-df-ink dark:text-df-ink-dark mb-1 font-bold">Lienzo a tu medida</h3>
						<p class="text-df-muted dark:text-df-muted-dark mb-4 text-xs leading-relaxed">
							Define tamaño y formato del lienzo para tu board. Construye con libertad y mantén todo
							ordenado.
						</p>
						<!-- Mini board mockup -->
						<div
							class="aspect-video overflow-hidden rounded-xl border border-gray-200 bg-gray-100 dark:border-gray-700 dark:bg-gray-800"
						>
							<div class="flex h-full">
								<!-- Sidebar -->
								<div class="flex w-16 shrink-0 flex-col gap-1 bg-gray-200 p-2 dark:bg-gray-900">
									{
										["#d1d5db", "#d1d5db", "#d1d5db", "#d1d5db", "#d1d5db"].map(() => (
											<div class="h-2 rounded bg-gray-300 dark:bg-gray-700" />
										))
									}
								</div>
								<!-- Content: mini image grid -->
								<div class="grid flex-1 grid-cols-2 gap-1 p-2">
									<img
										src="/minimal_serenity.png"
										alt=""
										class="h-full w-full rounded object-cover"
									/>
									<img
										src="/ethereal_canyons.png"
										alt=""
										class="h-full w-full rounded object-cover"
									/>
								</div>
							</div>
						</div>
					</div>

					<!-- Card 2: Listo para imprimir (violet) -->
					<div
						class="bg-df-primary dark:bg-df-primary-dark relative overflow-hidden rounded-2xl p-6"
					>
						<div class="mb-4 flex h-10 w-10 items-center justify-center rounded-xl bg-white/20">
							<Printer class="h-5 w-5 text-white" aria-hidden="true" />
						</div>
						<h3 class="mb-1 font-bold text-white">Listo para imprimir</h3>
						<p class="mb-4 text-xs leading-relaxed text-white/80">
							Exporta en alta calidad y prepara tu board para impresión o PDF, con control de DPI.
						</p>
						<p class="text-[10px] font-bold tracking-[0.15em] text-white/50 uppercase">
							PDF / PNG / JPG
						</p>
						<!-- Decorative -->
						<div
							class="absolute -right-6 -bottom-6 h-24 w-24 rounded-full bg-white/10"
							aria-hidden="true"
						>
						</div>
					</div>

					<!-- Card 3: Búsqueda Multiplataforma -->
					<div
						class="rounded-2xl border border-amber-100 bg-amber-50 p-6 dark:border-gray-700/60 dark:bg-gray-800/60"
					>
						<div
							class="bg-df-surface mb-4 flex h-10 w-10 items-center justify-center rounded-xl dark:bg-gray-700"
						>
							<Search class="text-df-muted dark:text-df-muted-dark h-5 w-5" aria-hidden="true" />
						</div>
						<h3 class="text-df-ink dark:text-df-ink-dark mb-1 font-bold">Búsqueda de imágenes</h3>
						<p class="text-df-muted dark:text-df-muted-dark mb-4 text-xs leading-relaxed">
							Busca inspiración en Unsplash y Pexels. Selecciona tus favoritas y llévalas al editor.
						</p>
						<!-- Thumbnails -->
						<div class="mb-3 flex gap-2">
							<img
								src="/ethereal_canyons.png"
								alt=""
								class="h-14 w-14 rounded-xl object-cover shadow-sm"
							/>
							<img
								src="/digital_pulse.png"
								alt=""
								class="h-14 w-14 rounded-xl object-cover shadow-sm"
							/>
							<img
								src="/crystal_ripples.png"
								alt=""
								class="h-14 w-14 rounded-xl object-cover shadow-sm"
							/>
						</div>
						<!-- Provider dots -->
						<div class="flex gap-2">
							<div
								class="bg-df-accent dark:bg-df-accent-dark h-5 w-5 rounded-full shadow-sm"
								title="Unsplash"
							>
							</div>
							<div
								class="bg-df-secondary dark:bg-df-secondary-dark h-5 w-5 rounded-full shadow-sm"
								title="Pexels"
							>
							</div>
						</div>
					</div>

					<!-- Card 4: Diseñando Premium (dark) -->
					<div class="relative overflow-hidden rounded-2xl bg-gray-950 p-6 dark:bg-gray-950">
						<img
							src="/tactile_form.png"
							alt=""
							class="absolute inset-0 h-full w-full object-cover opacity-15"
							aria-hidden="true"
						/>
						<div class="relative z-10">
							<div
								class="bg-df-primary/30 mb-4 flex h-10 w-10 items-center justify-center rounded-xl"
							>
								<Sparkles class="text-df-primary-dark h-5 w-5" aria-hidden="true" />
							</div>
							<h3 class="mb-1 font-bold text-white">Editor drag &amp; drop</h3>
							<p class="text-xs leading-relaxed text-gray-400">
								Arrastra imágenes al lienzo, muévelas, redimensiónalas y organiza tu composición con
								precisión.
							</p>
							<!-- Mini dark UI preview -->
							<div class="mt-4 rounded-lg border border-gray-800 bg-gray-900 p-2">
								<div class="grid grid-cols-3 gap-1">
									<img
										src="/minimal_serenity.png"
										alt=""
										class="aspect-square rounded object-cover"
									/>
									<img src="/twilight_path.png" alt="" class="aspect-square rounded object-cover" />
									<img src="/digital_pulse.png" alt="" class="aspect-square rounded object-cover" />
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- ══════════════════════════════════════════
         SHOWCASE / PHONE MOCKUPS
    ══════════════════════════════════════════ -->
		<section id="gallery" class="bg-df-surface dark:bg-df-surface-dark px-8 py-20">
			<div class="mx-auto max-w-5xl">
				<div class="mb-14 text-center">
					<h2 class="text-df-ink dark:text-df-ink-dark text-3xl font-extrabold">Cómo funciona</h2>
					<div class="bg-df-primary dark:bg-df-primary-dark mx-auto mt-3 h-1 w-12 rounded-full">
					</div>
					<p class="text-df-muted dark:text-df-muted-dark mx-auto mt-3 max-w-md text-sm">
						Tres pasos simples: explora imágenes, diseña tu lienzo y exporta en el formato que
						necesitas.
					</p>
				</div>

				<!-- 3 phone mockups -->
				<div class="flex items-end justify-center gap-6">
					<!-- Phone 1: smaller -->
					<div class="text-center">
						<div
							class="mx-auto w-36 overflow-hidden rounded-[28px] border-[5px] border-gray-900 bg-gray-900 shadow-2xl shadow-gray-900/30 dark:border-gray-600"
							style="min-height: 280px;"
						>
							<img
								src="/ethereal_canyons.png"
								alt=""
								class="h-full w-full object-cover"
								style="min-height: 280px;"
								loading="lazy"
							/>
						</div>
						<h3 class="text-df-ink dark:text-df-ink-dark mt-4 text-sm font-bold">1) Explora</h3>
						<p class="text-df-muted dark:text-df-muted-dark mx-auto mt-1 max-w-[140px] text-xs">
							Busca y selecciona imágenes de Unsplash y Pexels.
						</p>
					</div>

					<!-- Phone 2: taller / center -->
					<div class="-mt-10 text-center">
						<div
							class="mx-auto w-44 overflow-hidden rounded-[32px] border-[6px] border-gray-900 bg-gray-900 shadow-2xl shadow-gray-900/40 dark:border-gray-700"
							style="min-height: 360px;"
						>
							<img
								src="/digital_pulse.png"
								alt=""
								class="h-full w-full object-cover"
								style="min-height: 360px;"
								loading="lazy"
							/>
						</div>
						<h3 class="text-df-ink dark:text-df-ink-dark mt-4 text-sm font-bold">2) Diseña</h3>
						<p class="text-df-muted dark:text-df-muted-dark mx-auto mt-1 max-w-[160px] text-xs">
							Arrastra, ajusta y organiza elementos en tu lienzo.
						</p>
					</div>

					<!-- Phone 3: smaller -->
					<div class="text-center">
						<div
							class="mx-auto w-36 overflow-hidden rounded-[28px] border-[5px] border-gray-900 bg-gray-900 shadow-2xl shadow-gray-900/30 dark:border-gray-600"
							style="min-height: 280px;"
						>
							<img
								src="/crystal_ripples.png"
								alt=""
								class="h-full w-full object-cover"
								style="min-height: 280px;"
								loading="lazy"
							/>
						</div>
						<h3 class="text-df-ink dark:text-df-ink-dark mt-4 text-sm font-bold">3) Exporta</h3>
						<p class="text-df-muted dark:text-df-muted-dark mx-auto mt-1 max-w-[140px] text-xs">
							Guarda como PDF, PNG, JPG o JSON, listo para imprimir.
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- ══════════════════════════════════════════
         CTA
    ══════════════════════════════════════════ -->
		<section id="cta" class="bg-df-bg dark:bg-df-bg-dark px-8 py-20">
			<div class="mx-auto max-w-5xl">
				<div
					class="from-df-primary to-df-accent dark:from-df-primary-dark dark:to-df-accent-dark relative overflow-hidden rounded-3xl bg-gradient-to-br via-violet-600 px-12 py-16 text-center dark:via-violet-700"
				>
					<!-- Background image subtle -->
					<img
						src="/minimal_serenity.png"
						alt=""
						class="absolute inset-0 h-full w-full object-cover opacity-10 mix-blend-overlay"
						aria-hidden="true"
					/>

					<div class="relative z-10">
						<h2 class="mb-4 text-3xl leading-tight font-black text-white md:text-4xl">
							Crea un board que puedas usar de verdad.
						</h2>
						<p class="mx-auto mb-8 max-w-md text-sm leading-relaxed text-white/80">
							Explora imágenes, diseña tu lienzo y exporta en alta calidad para compartir o
							imprimir.
						</p>
						<div class="flex flex-wrap justify-center gap-4">
							<a
								href="/explore"
								class="text-df-primary rounded-full bg-white px-6 py-3 text-sm font-bold shadow-lg transition-colors hover:bg-gray-50"
							>
								Empezar ahora
							</a>
							<a
								href="/export"
								class="rounded-full border-2 border-white/50 px-6 py-3 text-sm font-bold text-white transition-colors hover:bg-white/10"
							>
								Ver opciones de exportación
							</a>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- ══════════════════════════════════════════
         FOOTER
    ══════════════════════════════════════════ -->
		<footer
			class="bg-df-surface dark:bg-df-surface-dark border-t border-gray-200 px-8 pt-12 pb-8 dark:border-gray-800"
		>
			<div class="mx-auto max-w-5xl">
				<div class="mb-10 grid grid-cols-4 gap-8">
					<!-- Brand -->
					<div class="col-span-1">
						<p class="text-df-ink dark:text-df-ink-dark mb-2 font-extrabold">
							<span class="text-df-primary dark:text-df-primary-dark">Ethereal</span>Vision
						</p>
						<p class="text-df-muted dark:text-df-muted-dark mb-4 text-xs leading-relaxed">
							Explora imágenes, diseña tu lienzo y exporta en alta calidad para compartir o
							imprimir.
						</p>
						<!-- Social icons -->
						<div class="flex gap-3">
							{
								[
									"M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z",
									"M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2z M4 6a2 2 0 1 0 0-4 2 2 0 0 0 0 4z",
								].map((d) => (
									<a
										href="#"
										class="text-df-muted dark:text-df-muted-dark hover:bg-df-primary/10 dark:hover:bg-df-primary-dark/10 hover:text-df-primary dark:hover:text-df-primary-dark flex h-7 w-7 items-center justify-center rounded-full bg-gray-100 transition-colors dark:bg-gray-800"
									>
										<svg
											class="h-3.5 w-3.5"
											fill="none"
											viewBox="0 0 24 24"
											stroke="currentColor"
											stroke-width="2"
											aria-hidden="true"
										>
											<path d={d} />
										</svg>
									</a>
								))
							}
						</div>
					</div>

					<!-- Product -->
					<div>
						<h3
							class="text-df-muted dark:text-df-muted-dark mb-4 text-[10px] font-bold tracking-[0.2em] uppercase"
						>
							Product
						</h3>
						<ul class="space-y-2.5">
							{
								[
									{ label: "Explora", href: "/explore" },
									{ label: "Lienzo", href: "/canvas" },
									{ label: "Diseña", href: "/design" },
									{ label: "Exporta", href: "/export" },
								].map(({ label, href }) => (
									<li>
										<a
											href={href}
											class="text-df-muted dark:text-df-muted-dark hover:text-df-ink dark:hover:text-df-ink-dark text-xs transition-colors"
										>
											{label}
										</a>
									</li>
								))
							}
						</ul>
					</div>

					<!-- Resources -->
					<div>
						<h3
							class="text-df-muted dark:text-df-muted-dark mb-4 text-[10px] font-bold tracking-[0.2em] uppercase"
						>
							Resources
						</h3>
						<ul class="space-y-2.5">
							{
								["Help Centre", "Documentation", "Blog", "Status"].map((item) => (
