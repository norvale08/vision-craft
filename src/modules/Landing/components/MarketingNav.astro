---
import { Sun, Moon } from "lucide-astro";

const links = [
	{ href: "#inicio", label: "Inicio", active: true },
	{ href: "#features", label: "Funciones" },
	{ href: "#gallery", label: "Cómo funciona" },
	{ href: "#roadmap", label: "Roadmap" },
];
---

<nav
	class="fixed top-0 right-0 left-0 z-50 flex h-14 items-center gap-6 border-b border-gray-200/60 px-8 backdrop-blur-sm dark:border-gray-800/60"
>
	<a href="/" class="mr-4 shrink-0 text-base font-extrabold">
		<span class="text-df-primary dark:text-df-primary-dark">Vision</span><span
			class="text-df-ink dark:text-df-ink-dark">Craft</span
		>
	</a>
	<div class="hidden flex-1 gap-6 md:flex">
		{
			links.map(({ href, label, active }) => (
				<a
					href={href}
					class:list={[
						"text-sm font-medium transition-colors",
						active
							? "text-df-ink dark:text-df-ink-dark border-df-primary dark:border-df-primary-dark border-b-2 pb-0.5"
							: "text-df-muted dark:text-df-muted-dark hover:text-df-ink dark:hover:text-df-ink-dark",
					]}
				>
					{label}
				</a>
			))
		}
	</div>
	<div class="ml-auto flex items-center gap-3">
		<button
			id="landing-theme-toggle"
			aria-label="Toggle dark mode"
			class="text-df-muted dark:text-df-muted-dark rounded-full p-2 transition-colors hover:bg-gray-100 dark:hover:bg-gray-800"
		>
			<Sun class="hidden h-4 w-4 dark:block" aria-hidden="true" />
			<Moon class="block h-4 w-4 dark:hidden" aria-hidden="true" />
		</button>
		<a
			href="/explore"
			class="bg-df-primary dark:bg-df-primary-dark rounded-full px-4 py-2 text-sm font-bold text-white shadow-sm transition-opacity hover:opacity-90"
		>
			Empezar
		</a>
	</div>
</nav>

<script>
	const btn = document.getElementById("landing-theme-toggle");
	btn?.addEventListener("click", () => {
		const isDark = document.documentElement.classList.toggle("dark");
		localStorage.setItem("df-theme", isDark ? "dark" : "light");
	});
</script>
