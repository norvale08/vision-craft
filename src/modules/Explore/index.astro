---
import StudioLayout from "../../shared/components/StudioLayout.astro";
import PageHeader from "../../shared/components/PageHeader.astro";
import PageFooter from "../../shared/components/PageFooter.astro";
import ImagesGallery from "./components/ImagesGallery";
import HeaderAddImages from "./components/HeaderAddImages";
---

<StudioLayout activeItem="explore">
	<div class="flex-1 px-8 py-10">
		<!-- ── Page header ────────────────────────────── -->
		<div class="mb-10 flex flex-col items-start justify-between gap-6 md:flex-row">
			<PageHeader
				activeItem="explore"
				title="Selecciona tus"
				highlight="Imágenes."
				class="mb-8 flex w-full justify-between"
			>
				<HeaderAddImages client:load />
			</PageHeader>
		</div>

		<!-- ── Image gallery ────────────────────────────── -->
		<ImagesGallery client:load />
	</div>

	<PageFooter>
		<nav aria-label="Footer">
			<ul class="flex gap-6" role="list">
				<li>
					<a
						href="#"
						class="text-df-muted dark:text-df-muted-dark hover:text-df-ink dark:hover:text-df-ink-dark text-[10px] font-semibold tracking-[0.18em] uppercase transition-colors"
					>
						Privacy Policy
					</a>
				</li>
				<li>
					<a
						href="#"
						class="text-df-muted dark:text-df-muted-dark hover:text-df-ink dark:hover:text-df-ink-dark text-[10px] font-semibold tracking-[0.18em] uppercase transition-colors"
					>
						Terms
					</a>
				</li>
			</ul>
		</nav>
	</PageFooter>
</StudioLayout>
