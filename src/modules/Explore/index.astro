---
import TopNav from "../../shared/components/TopNav.astro";
import AppSidebar from "../../shared/components/AppSidebar.astro";
// import Upload from "../../shared/icons/Upload.astro";
import ImagesGallery from "./components/ImagesGallery";
---

<>
	<TopNav />
	<AppSidebar activeItem="explore" />

	<main
		class="ml-44 pt-14 min-h-screen flex flex-col bg-df-bg dark:bg-df-bg-dark">
		<div class="flex-1 px-8 py-10">
			<!-- ── Page header ────────────────────────────── -->
			<div
				class="flex flex-col md:flex-row items-start justify-between gap-6 mb-10">
				<!-- Left: step label + heading -->
				<header>
					<p
						class="text-[10px] font-bold tracking-[0.2em] uppercase
                   text-df-muted dark:text-df-muted-dark mb-3">
						Paso 01 / Selección
					</p>
					<h1
						class="text-5xl font-extrabold leading-[1.1] text-df-ink dark:text-df-ink-dark">
						Selecciona tus<br />
						<span class="text-df-primary dark:text-df-primary-dark">
							Imágenes.
						</span>
					</h1>
				</header>

				<!-- Right: description + upload button -->
				<!-- <div
					class="flex flex-col items-end gap-4 shrink-0 max-w-[280px] text-right">
					<p
						class="text-sm leading-relaxed text-df-muted dark:text-df-muted-dark">
						Selecciona las imágenes que resuenen con tu visión. Mezcla de
						repositorios globales o sube tu propia esencia.
					</p>
					<button
						id="upload-btn"
						class="flex items-center gap-2 px-4 py-2.5 rounded-xl text-sm font-medium
                   border border-gray-200 dark:border-gray-700
                   bg-df-surface dark:bg-df-surface-dark
                   text-df-ink dark:text-df-ink-dark
                   hover:border-df-primary dark:hover:border-df-primary-dark
                   hover:shadow-sm transition-all duration-150">
						<Upload />
						Subir Imágenes
					</button>
				</div> -->
			</div>

			<!-- ── Image gallery ────────────────────────────── -->
			<ImagesGallery client:load />
		</div>

		<!-- ── Footer ──────────────────────────────────── -->
		<footer
			class="border-t border-gray-200 dark:border-gray-800 px-8 py-4
             flex items-center justify-between gap-4">
			<small
				class="text-[10px] font-semibold tracking-[0.18em] uppercase
               text-df-muted dark:text-df-muted-dark not-italic">
				&copy; 2024 Ethereal Professional. All rights reserved.
			</small>
			<nav aria-label="Footer">
				<ul class="flex gap-6" role="list">
					<li>
						<a
							href="#"
							class="text-[10px] font-semibold tracking-[0.18em] uppercase
                     text-df-muted dark:text-df-muted-dark
                     hover:text-df-ink dark:hover:text-df-ink-dark transition-colors">
							Privacy Policy
						</a>
					</li>
					<li>
						<a
							href="#"
							class="text-[10px] font-semibold tracking-[0.18em] uppercase
                     text-df-muted dark:text-df-muted-dark
                     hover:text-df-ink dark:hover:text-df-ink-dark transition-colors">
							Terms
						</a>
					</li>
				</ul>
			</nav>
		</footer>
	</main>
</>
