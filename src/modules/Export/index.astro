---
import StudioLayout from "../../shared/components/StudioLayout.astro";
import PageHeader from "../../shared/components/PageHeader.astro";
import PageFooter from "../../shared/components/PageFooter.astro";
import ExportPanel from "./components/ExportPanel";
---

<StudioLayout activeItem="export">
	<PageHeader
		activeItem="export"
		title="Exporta tu"
		highlight="Lienzo."
		description="Exporta tu visión board para imprimir en una hoja o como póster de varias hojas, o descárgalo como PNG/JPG para compartir. Todas las opciones mantienen la calidad y proporciones originales de tu lienzo."
	/>

	<ExportPanel client:only="react" />

	<PageFooter />
</StudioLayout>
